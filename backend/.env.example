# WangKira backend environment — copy to .env and adjust locally.
# .env is gitignored; .env.example is checked in as the template.

# SQLite DB path. Use an absolute path or one relative to the backend/ dir.
DATABASE_URL=sqlite:///wangkira.db

# Display / storage timezone. UTC for storage; this is the display tz.
TIMEZONE=Asia/Kuala_Lumpur

# Flask secret key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-local-env

# Flask runtime
FLASK_ENV=development
FLASK_DEBUG=1

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
